RewriteEngine On
RewriteBase /

# No folder listings
Options -Indexes

# Force HTTPS and www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.ezygobd.com%{REQUEST_URI} [L,R=301]

# Block private folders: form submissions, git data, editor settings
RewriteRule ^(submissions|ezy|\.git|\.vscode|Ecocyclec-main|tools|preview|_mock)(/|$) - [F,L]

# Block backups, archives, logs, docs and dotfiles (except .well-known for SSL)
<FilesMatch "\.(bak|old|orig|zip|tar|gz|sql|log|md|ini|env|json)$">
  Require all denied
</FilesMatch>
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
